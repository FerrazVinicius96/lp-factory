<style>
  /* .visor (fundo, cor, papéis) vive em sistema.css — compartilhado com
     CtaFinal.astro. Aqui só o que é específico do herói: a malha, o grid
     de duas colunas e as duas variáveis que a zona de campo precisa. */

  /* ═══ ZONA DE CAMPO — mesmo contrato de CampoSintetico.astro, para a malha ═══
     tokens.json > zona-campo: nenhuma camada decorativa tem alfa acima de
     zero onde há texto, em 320–1920px. A garantia é posicional: campo (PNG,
     estilizado em CampoSintetico.astro) e malha (SVG, aqui) ocupam
     exclusivamente a zona de campo — faixa sob o texto abaixo de 75rem,
     coluna à direita de --campo-limite a partir de 75rem — e a zona de
     campo nunca contém texto. As duas caixas são declaradas em componentes
     diferentes (o CSS com escopo do Astro não atravessa de componente pai
     para filho), mas obedecem à MESMA geometria — só por isso são
     equivalentes, não porque compartilham regra.
     Antes, a malha era deslocada com `left: 42%` sem reduzir a largura:
     alargava a caixa para além do container, cobria a coluna de texto
     abaixo de 60rem e jogava 531px da arcada para fora da tela acima dela.
     Foi o defeito que devolveu o gate. */
  .visor__malha {
    position: absolute;
    pointer-events: none;
    inset: auto 0 0 0;
    height: var(--campo-alt);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 18%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 18%);
    /* a arcada vem sempre mais forte que o campo sintético: o campo é
       profundidade, a arcada é o objeto que o visor está lendo. */
    opacity: 0.72;
  }
  .visor__malha svg { width: 100%; height: 100%; display: block; }
  .malha { fill: none; stroke: var(--color-malha); stroke-width: 0.5; }
  .malha-aberta { fill: none; stroke: var(--color-malha); stroke-width: 0.5; stroke-dasharray: 2 2; opacity: 0.5; }
  .malha-crista { fill: none; stroke: var(--color-medida-clara); stroke-width: 0.8; opacity: 0.85; }

  @media (min-width: 75rem) {
    /* a caixa da malha começa no limite, para a arcada centralizar dentro
       do campo visível em vez de ficar centralizada no viewport e cortada
       pela máscara. A rampa de 6em é a garantia; a caixa é composição. */
    .visor__malha {
      inset: 0 0 0 var(--campo-limite);
      height: auto;
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 6em);
      mask-image: linear-gradient(to right, transparent 0, #000 6em);
    }
  }

  .visor__interno {
    position: relative;
    max-width: 84rem;
    margin: 0 auto;
    /* respiro de baixo abre espaço para a faixa de campo sintético no mobile —
       nenhuma linha da coluna cai sobre a imagem. */
    padding: var(--spacing-respiro-hero, clamp(4rem, 12vh, 8rem)) var(--spacing-gutter)
      calc(var(--spacing-entre-secoes) + var(--campo-alt));
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--spacing-entre-blocos);
  }
  @media (min-width: 60rem) {
    /* o grid vira duas colunas (régua + texto) aqui, mas a zona de campo
       continua sendo faixa até 75rem — a reserva de altura só cai lá embaixo. */
    .visor__interno {
      grid-template-columns: var(--spacing-regua) minmax(0, 1fr);
      column-gap: var(--spacing-gutter);
      align-items: start;
    }
  }
  @media (min-width: 75rem) {
    .visor__interno { padding-bottom: var(--spacing-entre-secoes); }
  }
  /* Limite direito da coluna de texto do herói, remontado nas medidas do
     próprio grid: centralização + padding + régua + column-gap + a medida
     de leitura (--spacing-medida) + a folga do contrato de campo. */
  .visor {
    --campo-limite: calc(max(0px, (100% - 84rem) / 2) + var(--spacing-regua) + var(--spacing-gutter) * 2 + var(--spacing-medida) + var(--campo-folga));
    /* altura da zona de campo enquanto ela é faixa (< 75rem). Passada como
       `var(--campo-alt)` para <CampoSintetico altura="..." />, então as duas
       camadas (PNG e SVG) reservam exatamente a mesma altura. */
    --campo-alt: clamp(13rem, 40vw, 17rem);
  }

  .marca {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 1rem;
    margin: 0 0 var(--spacing-entre-blocos);
  }
  .hero__sub {
    font-size: clamp(1.125rem, 0.5vw + 1rem, 1.35rem);
    line-height: 1.45;
    color: var(--color-conteudo-suave);
    max-width: 34ch;
    margin-top: var(--spacing-interno);
  }
  .tira {
    margin-top: var(--spacing-entre-blocos);
    padding-top: var(--spacing-entre-linhas);
    border-top: var(--spacing-fio) solid var(--color-fio);
    font-size: 0.8125rem;
    color: var(--color-conteudo-suave);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.8rem;
    align-items: center;
  }
  .tira b { color: var(--color-conteudo); }

  /* Motivo de motion: a malha se resolve conforme o leitor desce. Um momento
     só, scroll-linked, sempre dentro de @supports + prefers-reduced-motion.
     Estado final é estático e legível: sem suporte (Firefox), nada se perde. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* a crista entra com o resto da captura — antes ela era a única parte
         da malha que nascia acesa, o que contradizia o próprio motivo: a
         medição não precede o dado (PROJECT.md, correção do Ciclo II). */
      /* Longhands puros, de propósito — nunca `animation:` (shorthand) numa
         regra que também tem `animation-timeline`: o minificador do build
         (Lightning CSS) funde as duas num `animation:` combinado que o
         Chrome rejeita por inteiro, apagando a animação em silêncio (era
         por isso que a malha nunca aparecia no Chrome — defeito raiz do
         Ciclo III, ver PROJECT.md e motion.css). */
      .malha, .malha-aberta, .malha-crista {
        opacity: 0;
        animation-name: capturar;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% cover 25%;
      }
      .malha-aberta { --alvo: 0.5; }
      .malha-crista { --alvo: 0.85; }
    }
  }
  @keyframes capturar { to { opacity: var(--alvo, 1); } }
</style>
