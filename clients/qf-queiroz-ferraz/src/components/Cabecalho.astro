---
/**
 * Cabecalho: assinatura da marca e o controle de tema.
 *
 * O tema padrao vem de `color-scheme: light dark` + `light-dark()`, sem JS.
 * Este botao apenas sobrepoe a preferencia do sistema escrevendo `data-tema`
 * no <html>. Ele nasce `hidden` e o script o revela: sem JS nao ha controle
 * quebrado na tela, e a pagina continua respeitando o sistema.
 * Sem persistencia: nenhum dado desta pagina vai para o armazenamento do navegador.
 */
---

<header class="topo">
  <p class="marca">
    <span class="marca__sigla">Q&amp;F</span>
    <span class="marca__nome">Queiroz e Ferraz · Advocacia de Família</span>
  </p>
  <button class="botao-fio" type="button" data-tema-alternar aria-pressed="false" hidden>
    Tema escuro
  </button>
</header>

<script>
  const botao = document.querySelector<HTMLButtonElement>('[data-tema-alternar]');
  if (botao) {
    const raiz = document.documentElement;
    const escuro = () => {
      const t = raiz.dataset.tema;
      return t ? t === 'escuro' : matchMedia('(prefers-color-scheme: dark)').matches;
    };
    const rotular = () => {
      const e = escuro();
      botao.textContent = e ? 'Tema claro' : 'Tema escuro';
      botao.setAttribute('aria-pressed', String(e));
    };
    botao.addEventListener('click', () => {
      raiz.dataset.tema = escuro() ? 'claro' : 'escuro';
      rotular();
    });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', rotular);
    botao.hidden = false;
    rotular();
  }
</script>

<style>
  .topo {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-interno);
    padding-block: 1.6rem 1.4rem;
    border-bottom: var(--spacing-fio) solid var(--color-fio);
    flex-wrap: wrap;
  }

  .marca {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin: 0;
    max-width: none;
  }

  .marca__sigla {
    font-family: var(--font-titulo);
    font-size: 1.6rem;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .marca__nome {
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-conteudo-suave);
  }
</style>
